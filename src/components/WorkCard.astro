---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Two-digit index shown as an editorial marker. */
  index: number;
}

const { entry, index } = Astro.props;
const { data } = entry;
const headline = data.metrics[0];
---

<a
  href={url(`/work/${entry.id}`)}
  class="group grid gap-x-8 gap-y-4 border-t border-[var(--line)] py-9 md:grid-cols-[3rem_1fr_auto]"
>
  <span class="num text-[0.75rem] text-[var(--fg-muted)]">
    {String(index).padStart(2, '0')}
  </span>

  <div class="max-w-[54ch]">
    <p class="eyebrow">{data.org} · {data.period}</p>
    <h3
      class="mt-2.5 text-[1.375rem] leading-snug tracking-[-0.02em] transition-colors group-hover:text-[var(--fg-accent)]"
    >
      {data.title}
    </h3>
    <p class="mt-3 text-[0.9375rem] leading-relaxed text-[var(--fg-muted)]">
      {data.summary}
    </p>
    {
      data.stack.length > 0 && (
        <p class="mt-4 text-[0.75rem] text-[var(--fg-muted)]">{data.stack.slice(0, 5).join(' · ')}</p>
      )
    }
  </div>

  {
    headline && (
      <div class="md:w-40 md:text-right">
        <p class="num text-[1.5rem] leading-none">{headline.value}</p>
        <p class="mt-2.5 text-[0.75rem] leading-snug text-[var(--fg-muted)]">{headline.label}</p>
      </div>
    )
  }
</a>

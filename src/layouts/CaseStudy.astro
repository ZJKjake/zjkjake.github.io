---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import MetricGrid from '../components/MetricGrid.astro';
import { url } from '../lib/url';
import { site } from '../data/site';

interface Props {
  entry: CollectionEntry<'work'>;
  prev?: CollectionEntry<'work'>;
  next?: CollectionEntry<'work'>;
  sections?: { slug: string; text: string }[];
}

const { entry, prev, next, sections = [] } = Astro.props;
const { data } = entry;

const showMedia = site.showCompanyMedia || !data.companyMedia;
const metrics = showMedia ? data.metrics : data.metrics.filter((m) => !m.note?.startsWith('Internal'));
---

<Base title={data.title} description={data.summary}>
  <article>
    <header class="mx-auto max-w-[74rem] px-6 pt-16 pb-12 sm:px-8 sm:pt-24">
      <a
        href={url('/work')}
        class="eyebrow link-underline inline-block transition-colors hover:text-[var(--fg)]"
      >
        ← Work
      </a>

      <h1 class="mt-8 max-w-[26ch] text-[2.25rem] leading-[1.08] tracking-[-0.03em] sm:text-[3rem]">
        {data.title}
      </h1>

      <p class="mt-7 max-w-[62ch] text-[1.125rem] leading-relaxed text-[var(--fg-muted)]">
        {data.lede}
      </p>

      <dl
        class="mt-10 grid max-w-3xl grid-cols-2 gap-x-8 gap-y-5 border-t border-[var(--line)] pt-7 sm:grid-cols-4"
      >
        <div>
          <dt class="eyebrow">Role</dt>
          <dd class="mt-2 text-[0.875rem] leading-snug">{data.role}</dd>
        </div>
        <div>
          <dt class="eyebrow">Organisation</dt>
          <dd class="mt-2 text-[0.875rem] leading-snug">{data.org}</dd>
        </div>
        <div>
          <dt class="eyebrow">Period</dt>
          <dd class="mt-2 text-[0.875rem] leading-snug">{data.period}</dd>
        </div>
        {
          data.location && (
            <div>
              <dt class="eyebrow">Location</dt>
              <dd class="mt-2 text-[0.875rem] leading-snug">{data.location}</dd>
            </div>
          )
        }
      </dl>

      {
        data.stack.length > 0 && (
          <div class="mt-8">
            <p class="eyebrow mb-3">Stack</p>
            <ul class="flex flex-wrap gap-x-2 gap-y-2">
              {data.stack.map((item) => (
                <li class="border border-[var(--line)] px-2.5 py-1 text-[0.75rem] text-[var(--fg-muted)]">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        data.links.length > 0 && (
          <nav aria-label="Related links" class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
            {data.links.map((link) => (
              <a
                href={link.local ? url(link.href) : link.href}
                rel={link.local ? undefined : 'noopener'}
                class="link-underline text-[0.875rem] text-[var(--fg-accent)]"
              >
                {link.label} ↗
              </a>
            ))}
          </nav>
        )
      }
    </header>

    {
      metrics.length > 0 && (
        <div class="mx-auto max-w-[74rem] px-6 sm:px-8">
          <div class="border-y border-[var(--line)] py-px">
            <MetricGrid metrics={metrics} columns={4} />
          </div>
        </div>
      )
    }

    <div class="mx-auto max-w-[74rem] px-6 sm:px-8">
      <div class="grid gap-16 py-16 lg:grid-cols-[minmax(0,68ch)_1fr]">
        <div class="prose-doc">
          <slot />
        </div>

        {
          sections.length > 2 && (
            <nav aria-label="On this page" class="hidden lg:block">
              <div class="sticky top-24">
                <p class="eyebrow border-b border-[var(--line)] pb-3">On this page</p>
                <ol class="mt-4 space-y-2.5">
                  {sections.map((section) => (
                    <li>
                      <a
                        href={`#${section.slug}`}
                        class="toc-link block text-[0.8125rem] leading-snug text-[var(--fg-muted)] transition-colors hover:text-[var(--fg)]"
                      >
                        {section.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            </nav>
          )
        }
      </div>
    </div>
  </article>

  <script>
    // Highlight the section currently in view. Progressive enhancement: the
    // table of contents is fully usable without this.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));

    if (links.length > 0 && 'IntersectionObserver' in window) {
      const setActive = (id: string) => {
        for (const link of links) {
          const isActive = link.hash === `#${id}`;
          link.style.color = isActive ? 'var(--fg)' : '';
          link.toggleAttribute('data-active', isActive);
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible?.target.id) setActive(visible.target.id);
        },
        // Bias the band toward the top of the viewport so the highlighted
        // entry matches the heading the reader is actually under.
        { rootMargin: '-72px 0px -65% 0px' },
      );

      for (const link of links) {
        const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        if (target) observer.observe(target);
      }
    }
  </script>

  {
    (prev || next) && (
      <nav
        aria-label="More work"
        class="mx-auto grid max-w-[74rem] gap-px border-t border-[var(--line)] bg-[var(--line)] px-6 sm:grid-cols-2 sm:px-8"
      >
        {prev ? (
          <a href={url(`/work/${prev.id}`)} class="group bg-[var(--bg)] py-8 pr-6">
            <p class="eyebrow">← Previous</p>
            <p class="mt-3 text-[1.0625rem] leading-snug transition-colors group-hover:text-[var(--fg-accent)]">
              {prev.data.shortTitle ?? prev.data.title}
            </p>
            <p class="mt-2 text-[0.8125rem] text-[var(--fg-muted)]">{prev.data.org}</p>
          </a>
        ) : (
          <div class="bg-[var(--bg)]" />
        )}
        {next ? (
          <a href={url(`/work/${next.id}`)} class="group bg-[var(--bg)] py-8 sm:pl-6 sm:text-right">
            <p class="eyebrow">Next →</p>
            <p class="mt-3 text-[1.0625rem] leading-snug transition-colors group-hover:text-[var(--fg-accent)]">
              {next.data.shortTitle ?? next.data.title}
            </p>
            <p class="mt-2 text-[0.8125rem] text-[var(--fg-muted)]">{next.data.org}</p>
          </a>
        ) : (
          <div class="bg-[var(--bg)]" />
        )}
      </nav>
    )
  }
</Base>
